{
  "name": "bitbucket-connector",
  "version": "1.0.0",
  "description": "verhy coo prozhect, i liketh ith",
  "main": "index.js",
  "scripts": {
    "start": "npm run build & node dist/index.js",
    "build": "npm run clean & webpack --progress",
    "dev": "npm run clean & cross-env NODE_ENV=development webpack --progress",
    "clean": "rimraf dist",
    "init:all": "npm run init:hooks & npm run init:node_modules",
    "init:node_modules": "rimraf node_modules & unzip node_modules",
    "init:hooks": "ncp ./hooks ./.git/hooks"
  },
  "author": "Hilda",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "1.4.5",
    "cors": "2.8.5",
    "express": "5.2.1",
    "express-async-handler": "1.1.4",
    "jsonwebtoken": "9.0.3",
    "request": "2.88.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.9",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "builtin-modules": "5.3.0",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "ncp": "2.0.0",
    "nodemon": "3.1.14",
    "nodemon-webpack-plugin": "4.3.2",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "ts-loader": "9.6.2",
    "webpack": "5.11.0",
    "webpack-cli": "7.2.3",
    "webpack-node-externals": "3.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,css,md}": "prettier --write"
  }
}
